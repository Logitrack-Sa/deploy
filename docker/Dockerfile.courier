FROM eclipse-temurin:25-jre

WORKDIR /app

# Crear usuario y grupo de sistema sin privilegios
RUN groupadd -r spring && useradd -r -g spring -s /sbin/nologin spring && \
    mkdir -p /secrets /config && chown -R spring:spring /app /secrets /config

# Copiar el artefacto precompilado
COPY courier-service/target/courier-service-*.jar /app/app.jar

ENV SERVER_PORT=8082 \
    SERVER_ADDRESS=0.0.0.0 \
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom"

USER spring:spring

EXPOSE 8082

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
