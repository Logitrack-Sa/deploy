# Generar secretos privados con: python scripts/prepare_local.py
# Usar --env-file target/local/runtime.env al ejecutar Compose.
DB_ROOT_PASSWORD=
SECURITY_DB_PASSWORD=
COURIER_DB_PASSWORD=
SHIPMENT_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
JWT_CERTS_DIRECTORY=
JWT_KEY_ID=
JWT_ISSUER=https://security-service
JWT_AUDIENCES=security-service,courier-service,shipment-service,chatbot-service,payment-service
SECURITY_ADMIN_ENABLED=true
SECURITY_ADMIN_USERNAME=local-admin
SECURITY_ADMIN_EMAIL=local-admin@example.test
SECURITY_ADMIN_PASSWORD=
RABBITMQ_DEFAULT_USER=logitrack
RABBITMQ_DEFAULT_PASS=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
CONFIG_GIT_LABEL=main
MYSQL_VOLUME_NAME=logitrack_local_mysql
LOGITRACK_NETWORK_NAME=logitrack_local_network
LOGITRACK_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST_CONFIG_PORT=9088
HOST_EUREKA_PORT=9065
HOST_GATEWAY_PORT=8086
HOST_FRONTEND_PORT=3000
HOST_MYSQL_PORT=3308
HOST_SECURITY_PORT=8083
HOST_COURIER_PORT=8082
HOST_SHIPMENT_PORT=8081
HOST_PAYMENT_PORT=8085
HOST_REDIS_PORT=6380
HOST_RABBITMQ_AMQP_PORT=5673
HOST_RABBITMQ_MGMT_PORT=15673
HOST_PROMETHEUS_PORT=9090
HOST_GRAFANA_PORT=3001
HOST_MAILPIT_PORT=8025
FRONTEND_API_GATEWAY_URL=http://localhost:8086
FRONTEND_CUSTOMER_CANCELLATION_ENABLED=true
FRONTEND_PAYMENTS_ENABLED=false
FRONTEND_BASE_PATH=
# Correo externo opcional. El entorno local usa Mailpit.
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=
# Para IA, completar proveedor/modelo y arrancar con --profile ai.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com
AI_COMPLETIONS_PATH=/v1/chat/completions
GEMINI_PROXY_ENABLED=false
# Mantener sandbox en desarrollo. Las credenciales reales van en archivos privados.
PAYMENTS_ENABLED=false
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
