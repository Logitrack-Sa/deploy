# ==========================================
# PUERTOS EXPUESTOS EN EL HOST
# ==========================================
HOST_MYSQL_PORT=3307
HOST_EUREKA_PORT=8065
HOST_GATEWAY_PORT=8080
HOST_SECURITY_PORT=8083
HOST_COURIER_PORT=8082
HOST_SHIPMENT_PORT=8081
HOST_CHATBOT_PORT=8084
CONFIG_GIT_LABEL=develop

# ==========================================
# BASE DE DATOS MYSQL
# ==========================================
DB_ROOT_PASSWORD=rootpassword
DB_USER=logitrack
DB_PASSWORD=logitrack-dev

# ==========================================
# SEGURIDAD Y JWT (Claves criptográficas)
# ==========================================
JWT_KEY_ID=logitrack-main
JWT_ISSUER=https://security-service
JWT_AUDIENCES=security-service,courier-service,shipment-service,chatbot-service
SECURITY_ADMIN_USERNAME=admin
SECURITY_ADMIN_PASSWORD=admin123

# ==========================================
# CORREO ELECTRÓNICO (GMAIL SMTP)
# Se leen de las variables de entorno del sistema o puedes definirlas localmente sin subirlas
# ==========================================
# GMAIL_SMTP_USERNAME=
# GMAIL_SMTP_APP_PASSWORD=

# ==========================================
# PUERTOS INFRAESTRUCTURA, GATEWAY Y MONITOREO
# ==========================================
HOST_REDIS_PORT=6379
HOST_RABBITMQ_AMQP_PORT=5672
HOST_RABBITMQ_MGMT_PORT=15672
HOST_PROMETHEUS_PORT=9090
HOST_GRAFANA_PORT=3001

# ==========================================
# CREDENCIALES DE RABBITMQ
# ==========================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ==========================================
# CREDENCIALES DE GRAFANA
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
